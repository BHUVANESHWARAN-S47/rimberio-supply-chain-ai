# RIMBERIO Multi-Agent Supply Chain Decision Platform
# Environment Configuration Template

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+asyncpg://rimberio_admin:rimberio_secure_pass@localhost:5432/rimberio
DATABASE_SYNC_URL=postgresql+psycopg2://rimberio_admin:rimberio_secure_pass@localhost:5432/rimberio
# SQLite fallback for local test/dev when Postgres is not running:
# DATABASE_URL=sqlite+aiosqlite:///backend/data/rimberio_enterprise.db
# DATABASE_SYNC_URL=sqlite:///backend/data/rimberio_enterprise.db

# ChromaDB Vector Store
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./backend/data/chroma_db

# AI & LLM Service Configuration (local Ollama Admin Manager AI)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.1
OPENAI_API_KEY=your_openai_api_key_here


# Observability & Logging
LOG_LEVEL=INFO
LOG_DIR=./backend/data/logs

# Security & Application Settings
SECRET_KEY=rimberio_jwt_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
